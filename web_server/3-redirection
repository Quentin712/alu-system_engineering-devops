#!/usr/bin/env bash
# Installs Nginx and configures a 301 redirect for /redirect_me

# Re-run as root if started by a normal user
if [ "$(id -u)" -ne 0 ]; then
    exec sudo bash "$0" "$@"
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y nginx

# Add the redirect only once
if ! grep -q "redirect_me" /etc/nginx/sites-available/default; then
    sed -i '0,/server_name _;/s//server_name _;\n\n\tlocation \/redirect_me {\n\t\treturn 301 https:\/\/www.youtube.com\/watch?v=QH2-TGUlwu4;\n\t}/' /etc/nginx/sites-available/default
fi

nginx -t && service nginx restart
