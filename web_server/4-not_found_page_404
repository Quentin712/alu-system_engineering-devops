#!/usr/bin/env bash
# Installs nginx with a 301 redirect on /redirect_me and a custom 404 page
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
sed -i '/server_name _;/a\        error_page 404 /404.html;\n        location = /404.html { internal; }\n        location /redirect_me { return 301 https://www.youtube.com/watch?v=QH2-TGUlwu4; }' /etc/nginx/sites-available/default
nginx -t && service nginx restart
