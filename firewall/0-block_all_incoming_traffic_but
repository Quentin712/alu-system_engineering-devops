#!/usr/bin/env bash
# Installs ufw and blocks all incoming traffic except TCP ports 22, 80 and 443

# Re-run as root if started by a normal user
if [ "$(id -u)" -ne 0 ]; then
    exec sudo bash "$0" "$@"
fi

apt-get update -y
apt-get install -y ufw

ufw default deny incoming
ufw default allow outgoing

ufw allow 22/tcp
ufw allow 80/tcp
ufw allow 443/tcp

ufw --force enable
ufw status verbose
