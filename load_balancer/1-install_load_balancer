#!/usr/bin/env bash
# Configures a new Ubuntu machine: installs Nginx and adds the
# X-Served-By response header containing the server hostname.
# shellcheck disable=SC2016

# Re-run this script as root if it was started by a normal user
if [ "$(id -u)" -ne 0 ]; then
    exec sudo bash "$0" "$@"
fi

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y nginx

# Remove any old copy of the header from the default site (avoids duplicates)
sed -i '/X-Served-By/d' /etc/nginx/sites-available/default

# Drop-in file loaded inside Nginx's http block
echo 'add_header X-Served-By $hostname;' > /etc/nginx/conf.d/custom_header.conf

nginx -t && service nginx restart
