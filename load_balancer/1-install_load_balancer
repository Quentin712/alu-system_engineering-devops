#!/usr/bin/env bash
# Configures a new Ubuntu machine: installs Nginx and adds the
# X-Served-By response header containing the server hostname.
# shellcheck disable=SC2016

run() {
    if [ "$(id -u)" -eq 0 ]; then
        "$@"
    else
        sudo "$@"
    fi
}

export DEBIAN_FRONTEND=noninteractive
run apt-get update -y
run apt-get install -y nginx

# Remove any older copy of the header from the default site (avoids duplicates)
run sed -i '/X-Served-By/d' /etc/nginx/sites-available/default

# Drop-in file loaded in the http block, so it applies to every server block
echo 'add_header X-Served-By $hostname;' | run tee /etc/nginx/conf.d/custom_header.conf > /dev/null

run nginx -t && run service nginx restart
